{
  "name": "icann-pebble",
  "version": "0.2.0",
  "author": "ICANN DNS",
  "summary": "Install and configure Let's Encrypt Pebble on Ubuntu",
  "license": "Apache-2.0",
  "source": "https://github.com/icann-dns/puppet-pebble",
  "project_page": "https://github.com/icann-dns/puppet-pebble",
  "issues_url": "https://github.com/icann-dns/puppet-pebble/issues",
  "requirements": [
    {
      "name": "puppet",
      "version_requirement": ">= 8.10.0 < 9.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "22.04"
      ]
    }
  ],
  "dependencies": [
    {
      "name": "puppetlabs-stdlib",
      "version_requirement": ">= 9.7.0"
    },
    {
      "name": "puppet-extlib",
      "version_requirement": ">= 8.4.0"
    },
    {
      "name": "puppet-systemd",
      "version_requirement": ">= 9.4.0"
    }
  ]
}
